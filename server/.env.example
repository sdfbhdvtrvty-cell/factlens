# Google Gemini API key for fact-checking
GOOGLE_API_KEY=AIza...
# Gemini model used for fact-checking
GEMINI_MODEL=gemini-3.8-flash
# Let the model search the web so verdicts are grounded in current sources
ENABLE_GOOGLE_SEARCH=false
# Optional shared secret; must match the "Access token" in the extension popup
EXTENSION_TOKEN=
PORT=3000
# Daily API call cap (Gemini free tier ≈ 1500/day); server rejects
# requests once this is hit and shows a clear error with time-to-reset.
DAILY_LIMIT=1400